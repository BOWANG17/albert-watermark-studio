/* Albert水印工坊 · 深色毛玻璃主题（macOS 风格）
 *
 * 设计原则：用半透明深色表面 + 细微内边框模拟毛玻璃质感，让照片成为唯一主角。
 * - 主窗口用深色渐变作底色，为半透明面板提供"透出的层次"
 * - 各面板用 rgba 半透明表面 + 1px 半透明白内边框（模拟玻璃边缘高光）
 * - 分层深度：主背景 → 侧栏面板 → 折叠头/卡片 → 控件
 *
 * 圆角规范：面板/卡片 10px；控件 8px；圆形元素（滑块 handle）8px；
 * 轨道/细条 2px；折叠头平角 0。
 */

QMainWindow, QWidget {
    background: transparent;
    color: #E8E8E8;
    font-family: "PingFang SC", "Hiragino Sans GB", "Helvetica Neue", sans-serif;
    font-size: 13px;
}

/* 主窗口根：深色渐变底色，让半透明面板透出层次感 */
QWidget#mainRoot {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #26262B, stop:0.5 #202024, stop:1 #1A1A1E);
}

/* 参数字段标签：比正文小一号，形成字号阶梯 */
QLabel#fieldLabel {
    color: #A6A6AE;
    font-size: 12px;
}

/* 分组内小节标题：比字段标签醒目，用于大分组内分区 */
QLabel#subsectionLabel {
    color: #7FA7E8;
    font-size: 12px;
    font-weight: 600;
    padding-top: 2px;
}

/* 折叠分组（自定义 section 头 + 内容）：毛玻璃卡片 */
QPushButton#sectionHeader {
    background: rgba(255, 255, 255, 0.04);
    color: #D2D2D8;
    border: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 0;
    padding: 9px 12px;
    font-size: 13px;
    font-weight: 500;
    text-align: left;
}
QPushButton#sectionHeader:hover {
    background: rgba(255, 255, 255, 0.08);
}
QPushButton#sectionHeader:checked {
    background: rgba(91, 141, 239, 0.16);
    color: #A8C4F5;
    border-left: 3px solid #5B8DEF;
}
QWidget#sectionContent {
    background: transparent;
}

/* 按钮：半透明玻璃表面 + 细白内边框 */
QPushButton {
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 8px;
    padding: 7px 16px;
    color: #E8E8E8;
}
QPushButton:hover {
    background: rgba(255, 255, 255, 0.13);
    border-color: rgba(255, 255, 255, 0.18);
}
QPushButton:pressed {
    background: rgba(255, 255, 255, 0.18);
}
QPushButton:disabled {
    color: #7A7A82;
    background: rgba(255, 255, 255, 0.03);
    border-color: rgba(255, 255, 255, 0.05);
}

/* 主操作按钮（导出）高亮 */
QPushButton#exportBtn {
    background: rgba(28, 58, 107, 0.85);
    border: 1px solid rgba(91, 141, 239, 0.35);
    color: #FFFFFF;
    font-weight: bold;
}
QPushButton#exportBtn:hover {
    background: rgba(47, 84, 150, 0.95);
}
QPushButton#exportBtn:disabled {
    background: rgba(58, 63, 74, 0.6);
    border-color: rgba(255, 255, 255, 0.06);
    color: #888888;
}

/* 一键恢复默认按钮：中性提示色，弱化存在感 */
QPushButton#resetBtn {
    background: rgba(255, 255, 255, 0.05);
    border: 1px dashed rgba(255, 255, 255, 0.18);
    color: #A6A6AE;
}
QPushButton#resetBtn:hover {
    background: rgba(255, 255, 255, 0.10);
    border-color: rgba(91, 141, 239, 0.5);
    color: #C9D8F0;
}

/* 导出栏工具按钮（主题切换 / 关于）：保持普通按钮外观，不受 checkable 规则影响 */
QPushButton#themeBtn, QPushButton#infoBtn {
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.10);
    color: #E8E8E8;
}
QPushButton#themeBtn:hover, QPushButton#infoBtn:hover {
    background: rgba(255, 255, 255, 0.13);
}
QPushButton#themeBtn:checked, QPushButton#infoBtn:checked {
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.10);
    color: #E8E8E8;
}

/* 输入框：半透明深色 + 细内边框 */
QLineEdit {
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 8px;
    padding: 6px 10px;
    background: rgba(0, 0, 0, 0.25);
    color: #E8E8E8;
}
QLineEdit:focus {
    border-color: rgba(91, 141, 239, 0.6);
    background: rgba(0, 0, 0, 0.32);
}

/* 下拉框 */
QComboBox {
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 8px;
    padding: 5px 10px;
    background: rgba(0, 0, 0, 0.25);
    color: #E8E8E8;
}
QComboBox:focus {
    border-color: rgba(91, 141, 239, 0.6);
}
QComboBox::drop-down {
    border: none;
}
QComboBox QAbstractItemView {
    background: rgba(32, 32, 37, 0.97);
    color: #E8E8E8;
    border: 1px solid rgba(255, 255, 255, 0.12);
    selection-background-color: rgba(28, 58, 107, 0.9);
    selection-color: #FFFFFF;
}

/* 复选框 */
QCheckBox {
    spacing: 6px;
    color: #E8E8E8;
}

/* 九宫格位置按钮 */
QPushButton[checkable="true"] {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 8px;
    padding: 0px;
}
QPushButton[checkable="true"]:checked {
    background: rgba(28, 58, 107, 0.8);
    border: 1px solid rgba(91, 141, 239, 0.6);
}
QPushButton[checkable="true"]:hover {
    border-color: rgba(91, 141, 239, 0.6);
}

/* 数字输入框（描边粗细） */
QSpinBox {
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 8px;
    padding: 4px 8px;
    background: rgba(0, 0, 0, 0.25);
    color: #E8E8E8;
}
QSpinBox:focus {
    border-color: rgba(91, 141, 239, 0.6);
}
QSpinBox::up-button, QSpinBox::down-button {
    background: rgba(255, 255, 255, 0.06);
    border: none;
    width: 16px;
}
QSpinBox::up-button:hover, QSpinBox::down-button:hover {
    background: rgba(255, 255, 255, 0.12);
}
QSpinBox::up-arrow {
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-bottom: 4px solid #D2D2D8;
    width: 0;
    height: 0;
}
QSpinBox::down-arrow {
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 4px solid #D2D2D8;
    width: 0;
    height: 0;
}

/* 滑块 */
QSlider::groove:horizontal {
    height: 4px;
    background: rgba(255, 255, 255, 0.10);
    border-radius: 2px;
}
QSlider::handle:horizontal {
    width: 16px;
    height: 16px;
    margin: -6px 0;
    background: #7FA7E8;
    border: 2px solid rgba(255, 255, 255, 0.85);
    border-radius: 8px;
}
QSlider::handle:horizontal:hover {
    background: #9DBBF0;
}
QSlider::sub-page:horizontal {
    background: rgba(91, 141, 239, 0.8);
    border-radius: 2px;
}

/* 文件列表：半透明玻璃面板 */
QListWidget {
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.04);
    padding: 4px;
    color: #D2D2D8;
}
QListWidget::item {
    padding: 6px 8px;
    border-radius: 6px;
}
QListWidget::item:selected {
    background: rgba(28, 58, 107, 0.8);
    color: #FFFFFF;
}
QListWidget::item:hover {
    background: rgba(255, 255, 255, 0.08);
}

/* 进度条 */
QProgressBar {
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    background: rgba(0, 0, 0, 0.25);
    height: 16px;
    text-align: center;
    font-size: 11px;
    color: #D2D2D8;
}
QProgressBar::chunk {
    background: rgba(28, 58, 107, 0.85);
    border-radius: 7px;
}

/* 标签 */
QLabel {
    color: #E8E8E8;
}

/* 空状态提示（文件列表空时覆盖显示） */
QLabel#emptyHint {
    color: #6A6A72;
    font-size: 12px;
    background: transparent;
}

/* ============ 模版画廊（中间选模版区） ============ */
QLabel#galleryTitle {
    color: #E8E8E8;
    font-size: 18px;
    font-weight: 600;
    padding: 4px 2px;
}
QLabel#galleryHint {
    color: #6A6A72;
    font-size: 11px;
    padding: 0 2px 6px 2px;
}
QLabel#galleryGroupLabel {
    color: #7FA7E8;
    font-size: 12px;
    font-weight: 600;
    padding: 6px 2px 2px 2px;
}
QScrollArea#galleryScroll {
    background: transparent;
    border: none;
}
QWidget#galleryContent {
    background: transparent;
}
QWidget#templateCard {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 10px;
}
QWidget#templateCard:hover {
    background: rgba(255, 255, 255, 0.10);
    border-color: rgba(91, 141, 239, 0.6);
}
QWidget#templateCard[selected="true"] {
    background: rgba(28, 58, 107, 0.30);
    border: 1px solid rgba(91, 141, 239, 0.8);
}
QLabel#templateThumb {
    background: rgba(0, 0, 0, 0.20);
    border-radius: 6px;
    border: none;
}
QLabel#templateCardName {
    color: #D2D2D8;
    font-size: 12px;
    font-weight: 500;
}

/* ============ 右侧编辑详情面板 ============ */
QWidget#editorPanel {
    background: rgba(20, 20, 24, 0.60);
    border-left: 1px solid rgba(255, 255, 255, 0.08);
}
QLabel#editorTitle {
    color: #E8E8E8;
    font-size: 15px;
    font-weight: 600;
    padding: 8px 4px;
}
QPushButton#editorCloseBtn {
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 6px;
    color: #A6A6AE;
    font-size: 14px;
}
QPushButton#editorCloseBtn:hover {
    background: rgba(255, 255, 255, 0.16);
    color: #E8E8E8;
}

/* 语义色状态栏：statusKind 动态属性
 * neutral=默认灰 / info=蓝 / success=绿 / warning=橙 / danger=红 */
QLabel#statusLabel[statusKind="neutral"] {
    color: #A6A6AE;
}
QLabel#statusLabel[statusKind="info"] {
    color: #7FA7E8;
}
QLabel#statusLabel[statusKind="success"] {
    color: #4CAF7D;
}
QLabel#statusLabel[statusKind="warning"] {
    color: #D9A441;
}
QLabel#statusLabel[statusKind="danger"] {
    color: #E05656;
}

/* 滚动区与滚动条 */
QScrollArea {
    background: transparent;
    border: none;
}
QScrollBar:vertical {
    width: 10px;
    background: transparent;
}
QScrollBar::handle:vertical {
    background: rgba(255, 255, 255, 0.16);
    border-radius: 5px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover {
    background: rgba(255, 255, 255, 0.26);
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

/* ============ 关于 / 字体授权设置对话框（毛玻璃） ============ */
QDialog#aboutDialog, QWidget#aboutContent {
    background: #232328;
}
QLabel#aboutTitle {
    color: #E8E8E8;
    font-size: 20px;
    font-weight: 600;
}
QLabel#aboutVersion {
    color: #A6A6AE;
    font-size: 12px;
}
QLabel#aboutSection {
    color: #7FA7E8;
    font-size: 14px;
    font-weight: 600;
    padding: 4px 0;
}
QWidget#aboutFontCard {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 10px;
}
QLabel#aboutFontName {
    color: #E8E8E8;
    font-size: 14px;
    font-weight: 600;
}
QLabel#aboutFontKind {
    color: #7FA7E8;
    font-size: 11px;
    background: rgba(91, 141, 239, 0.18);
    border-radius: 4px;
    padding: 1px 6px;
}
QLabel#aboutFontLicense {
    color: #D9A441;
    font-size: 12px;
}
QLabel#aboutFontDesc {
    color: #A6A6AE;
    font-size: 12px;
}
QLabel#aboutTip {
    color: #7A7A82;
    font-size: 11px;
}
QPushButton#aboutClose {
    background: rgba(91, 141, 239, 0.85);
    color: #FFFFFF;
    border: none;
    border-radius: 8px;
    padding: 6px 20px;
}
QPushButton#aboutClose:hover {
    background: #7FA7E8;
}

/* 弹出提示框（QMessageBox）：显式深色底 + 浅色文字。
 *
 * 全局 QWidget 的 color 是浅色 #E8E8E8，而 macOS 上 QMessageBox 默认用
 * 系统浅色背景，导致浅色文字叠在浅色背景上几乎看不见（表现为"空白"提示框）。
 * 这里给 QMessageBox 及其子控件显式配色，保证文字可读。
 */
QMessageBox {
    background-color: #2A2A30;
}
QMessageBox QLabel {
    color: #E8E8E8;
    background: transparent;
}
QMessageBox QPushButton {
    color: #E8E8E8;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 8px;
    padding: 6px 18px;
}
QMessageBox QPushButton:hover {
    background: rgba(255, 255, 255, 0.15);
}
